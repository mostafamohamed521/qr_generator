DJANGO_SECRET_KEY=your-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Only set to true if a reverse proxy (nginx config in DEPLOY.md) sits in
# front of Django AND strips any client-supplied X-Forwarded-For/Proto
# before setting its own. If there's no such proxy, leave this unset --
# turning it on without one lets a client spoof its own IP/scheme and
# bypass rate limiting and HTTPS checks.
DJANGO_TRUST_PROXY_HEADERS=true
DATABASE_URL=sqlite:///db.sqlite3
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
